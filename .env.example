# Database (Postgres / Supabase)
DATABASE_URL=
DIRECT_URL=

# Blob Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Admin Auth (Clerk email-code sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/login
# Comma-separated emails allowed into the admin portal.
ADMIN_ALLOWED_EMAILS=

# Square — get these from https://developer.squareup.com/apps
# Use Sandbox credentials locally (NODE_ENV!=production) and Production
# credentials on Render. App ID + Location ID are public; the access token and
# webhook signature key are secret.
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Optional but recommended: signing key for the /api/webhooks/square endpoint.
# When set, incoming webhooks with a bad/missing signature are rejected (401).
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
